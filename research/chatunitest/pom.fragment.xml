<!-- Merge this plugin into a DISPOSABLE COPY of case-study/pom.xml.
     This is a current tool trial, not the original paper experiment. -->
<plugin>
  <groupId>io.github.zju-aces-ise</groupId>
  <artifactId>chatunitest-maven-plugin</artifactId>
  <version>2.1.1</version>
  <configuration>
    <apiKeys>${env.CHATUNITEST_API_KEY}</apiKeys>
    <!-- Explicit endpoint: current upstream source defaults to a third-party proxy. -->
    <url>https://api.openai.com/v1/chat/completions</url>
    <model>${env.CHATUNITEST_MODEL}</model>
    <testNumber>1</testNumber>
    <maxRounds>2</maxRounds>
    <thread>false</thread>
    <noExecution>false</noExecution>
    <merge>false</merge>
  </configuration>
</plugin>
