<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>
  <groupId>vn.edu.seminar</groupId>
  <artifactId>library-case-study</artifactId>
  <version>0.1.0</version>
  <properties>
    <!-- demo: đổi pom.xml làm khóa cache Maven đổi -->
    <java.version>25</java.version>
    <test.pattern>**/*Test.java</test.pattern>
    <test.excludedTags>baseline,antipattern,ai-draft,ai-gaps,ai-data</test.excludedTags>
    <coverage.gate.skip>false</coverage.gate.skip>
    <pit.tests>vn.edu.seminar.fine.FineCalculatorTest</pit.tests>
    <pit.classes>vn.edu.seminar.fine.FineCalculator</pit.classes>
  </properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <testResources>
      <testResource><directory>src/test/resources</directory></testResource>
      <testResource><directory>../ai/data</directory></testResource>
    </testResources>
    <plugins>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
      <configuration>
        <includes><include>${test.pattern}</include></includes>
        <excludedGroups>${test.excludedTags}</excludedGroups>
        <failIfNoTests>true</failIfNoTests>
      </configuration>
    </plugin>
    <plugin>
      <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.15</version>
      <executions>
        <execution><goals><goal>prepare-agent</goal></goals></execution>
        <execution><id>report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
        <execution><id>gate</id><phase>verify</phase><goals><goal>check</goal></goals>
          <configuration>
            <skip>${coverage.gate.skip}</skip>
            <rules><rule><element>CLASS</element><includes><include>vn.edu.seminar.fine.FineCalculator</include></includes>
              <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
            </rule></rules>
          </configuration>
        </execution>
      </executions>
    </plugin>
    <plugin>
      <groupId>org.pitest</groupId><artifactId>pitest-maven</artifactId><version>1.30.0</version>
      <dependencies><dependency><groupId>org.pitest</groupId><artifactId>pitest-junit5-plugin</artifactId><version>1.2.3</version></dependency></dependencies>
      <configuration>
        <targetClasses><param>${pit.classes}</param></targetClasses>
        <targetTests><param>${pit.tests}</param></targetTests>
        <threads>2</threads><timestampedReports>false</timestampedReports>
        <outputFormats><param>HTML</param><param>XML</param></outputFormats>
      </configuration>
    </plugin>
  </plugins></build>
  <profiles>
    <profile><id>baseline</id><properties><test.pattern>**/FineCalculatorBaselineTest.java</test.pattern><test.excludedTags></test.excludedTags><coverage.gate.skip>true</coverage.gate.skip></properties></profile>
    <profile><id>coverage-trap</id><properties><test.pattern>**/FineCalculatorTrapTest.java</test.pattern><test.excludedTags></test.excludedTags><pit.tests>vn.edu.seminar.fine.FineCalculatorTrapTest</pit.tests></properties></profile>
    <profile><id>ai-draft</id><properties><test.pattern>**/FineCalculatorAiDraftTest.java</test.pattern><test.excludedTags></test.excludedTags><coverage.gate.skip>true</coverage.gate.skip></properties></profile>
    <profile><id>ai-improved</id><properties><test.pattern>**/FineCalculatorAi*Test.java</test.pattern><test.excludedTags>ai-data</test.excludedTags></properties></profile>
    <profile><id>ai-data</id><properties><test.pattern>**/FineCalculatorAiDataTest.java</test.pattern><test.excludedTags></test.excludedTags><coverage.gate.skip>true</coverage.gate.skip></properties></profile>
  </profiles>
</project>
